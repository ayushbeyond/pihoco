{
  "rewrites": [
    {
      "source": "/app/:path((?!assets/).*)",
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/app/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/home-v2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-v2/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "/menu-xray/",
      "permanent": false
    },
    {
      "source": "/app/",
      "destination": "/menu-xray/",
      "permanent": false
    },
    {
      "source": "/workspace",
      "destination": "/menu-intelligence/#team",
      "permanent": false
    },
    {
      "source": "/workspace/(.*)",
      "destination": "/menu-intelligence/#team",
      "permanent": false
    }
  ]
}
